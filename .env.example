# Application Configuration
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="SMARTCASEBD"

# Firebase Client Environment Variables (From Firebase Console -> Project Settings)
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourApiKeyHere"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="smartcasebd.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="smartcasebd"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="smartcasebd.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="1234567890"
NEXT_PUBLIC_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"

# Firebase Admin SDK Credentials (From Firebase Console -> Project Settings -> Service Accounts)
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@smartcasebd.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyHere\n-----END PRIVATE KEY-----\n"

# SQLite / Prisma Fallback (Optional)
DATABASE_URL="file:./dev.db"

# JWT Auth Secrets
JWT_SECRET="smartcasebd_jwt_secret_key_2026_flagship_secure_hash"
ADMIN_JWT_SECRET="smartcasebd_admin_secret_key_2026_rbac_access_hash"
