    "framer-motion": "^12.4.10",
    "jose": "^6.0.11",
    "lucide-react": "^0.477.0",
    "next": "^15.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.1",
